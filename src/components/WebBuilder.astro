---
/**
 * The Sixth Form builder (SPEC-SIXTH-FORM § 5): goals and challenges, an editor
 * with index.html / style.css / script.js tabs, and a preview that runs the
 * student's JavaScript, with a console and feedback. Behaviour: web-builder.ts.
 */
import Mascot from './Mascot.astro';
import PseudocodePanel from './PseudocodePanel.astro';
import { config } from '../config';
---
<div class="wb" data-web-builder>
  <section class="panel wb-goals" aria-labelledby="level-title">
    <div class="head">
      <p class="pixel level-tag" data-level-tag>LEVEL 1</p>
      <h1 class="level-title" id="level-title" data-level-title>Page skeleton</h1>
    </div>
    <p class="intro" data-level-intro></p>
    <p class="visually-hidden" aria-live="polite" data-goal-summary></p>
    <h2 class="sub" data-build-heading><span class="pill build">Build</span> Your app</h2>
    <ul class="goals" data-goals></ul>
    <div class="challenges" data-challenges-wrap hidden>
      <h2 class="sub">Challenges <span class="sub-note" data-challenge-count></span></h2>
      <p class="sub-note" data-challenge-note>Code you didn't write. Try each one to clear the level.</p>
      <div data-challenges></div>
    </div>
  </section>

  <section class="panel wb-editor" aria-labelledby="editor-heading">
    <h2 id="editor-heading" class="visually-hidden">Your code</h2>
    <div class="tabbar">
      <div class="tabs" role="tablist" aria-label="Files" data-tabs></div>
      <div class="tools">
        <button type="button" class="tool" data-pseudo-open>Pseudocode ↔ JS</button>
        <button type="button" class="tool" data-download>Download my code</button>
        <button type="button" class="tool" data-reset>Start again</button>
      </div>
    </div>
    <div class="editors" data-editors></div>
    <p class="ed-foot" id="editor-keys"><span data-file-label>index.html · HTML</span><span>Tab indents · Esc leaves the editor · Shaded lines are given</span></p>
  </section>

  <div class="wb-right">
    <section class="panel preview" aria-labelledby="preview-heading">
      <h2 id="preview-heading" class="visually-hidden">Preview: your app, running</h2>
      <div class="chrome" aria-hidden="true">
        <span class="dots"><i></i><i></i><i></i></span>
        <span class="tab"><span class="tab-icon"></span><span class="tab-title" data-tab-title>Untitled</span><span class="why">&lt;title&gt;</span></span>
        <button type="button" class="rerun" data-rerun tabindex="-1">↻ Run again</button>
      </div>
      <div class="address" aria-hidden="true"><span class="lock"></span>index.html</div>
      <p class="visually-hidden" aria-live="polite" data-tab-announce></p>
      <div class="frame-wrap" data-runner-host>
        <div class="alert-box" data-alert hidden role="alertdialog" aria-modal="false" aria-labelledby="alert-head" aria-describedby="alert-text">
          <p class="alert-head" id="alert-head">This page says</p>
          <p class="alert-text" id="alert-text" data-alert-text></p>
          <button type="button" class="btn btn-gold" data-alert-ok>OK</button>
        </div>
      </div>
      <p class="link-note" data-link-note hidden role="status"></p>
    </section>

    <details class="panel console" data-console open>
      <summary>Console <span class="count" data-console-count></span><button type="button" class="clear" data-console-clear>Clear</button></summary>
      <ol class="lines" data-console-lines aria-live="polite"></ol>
    </details>

    <section class="panel feedback" aria-labelledby="feedback-heading">
      <h2 id="feedback-heading" class="visually-hidden">Feedback from {config.mascot.name}</h2>
      <div class="say">
        <Mascot id="mascot" size={64} />
        <div class="bubble">
          <p class="message" data-message aria-live="polite">Write your code, then press Check my code.</p>
          <button type="button" class="btn btn-quiet goto" data-goto hidden>Go to line</button>
          <ul class="mistakes" data-mistakes hidden></ul>
        </div>
      </div>
      <div class="actions">
        <button type="button" class="btn btn-quiet report-btn" data-report-open>Download my report</button>
        <button type="button" class="btn btn-gold btn-big" data-check>Check my code</button>
        <a class="btn btn-big next" data-next href="#" aria-disabled="true">Next <span aria-hidden="true">▶</span></a>
      </div>
    </section>
  </div>

  <!-- Hidden copies for HTML and CSS checks: scripts removed, same origin. -->
  <div class="check-frames" aria-hidden="true">
    <iframe data-static sandbox="allow-same-origin" title="Copy of your page used for checking" tabindex="-1"></iframe>
    <iframe data-twin sandbox="allow-same-origin" title="Unstyled copy used for checking" tabindex="-1"></iframe>
    <div data-test-host></div>
  </div>
</div>

<template id="goal-template">
  <li class="goal" data-state="fail">
    <span class="tick" aria-hidden="true"></span>
    <div class="goal-body">
      <div class="goal-row">
        <p class="goal-text"><span class="visually-hidden goal-status">Not done yet:</span> <span class="text"></span></p>
        <button type="button" class="btn btn-quiet hint-btn">Hint</button>
      </div>
      <p class="spec" hidden></p>
      <p class="goal-msg" hidden></p>
      <ol class="hints" hidden></ol>
    </div>
  </li>
</template>

<dialog class="confirm" data-confirm aria-labelledby="confirm-title">
  <form method="dialog">
    <h2 id="confirm-title">Start again?</h2>
    <p>This clears all three files, your progress on every level and your challenge answers. Your brief stays the same. You can't undo this.</p>
    <div class="row">
      <button class="btn" value="cancel" autofocus>Keep my work</button>
      <button class="btn btn-gold" value="reset">Yes, start again</button>
    </div>
  </form>
</dialog>

<dialog class="confirm report" data-report aria-labelledby="report-title" aria-describedby="report-about">
  <form method="dialog">
    <h2 id="report-title">Download my report</h2>
    <p id="report-about">You get a PDF with your levels, challenge results, a picture of your app and all three files. Upload it to your Teams assignment.</p>
    <label for="report-name">Your name</label>
    <input id="report-name" name="name" type="text" maxlength="60" autocomplete="name" spellcheck="false" autofocus />
    <p class="note">Your name only goes in the PDF. It isn't saved or sent anywhere.</p>
    <div class="row">
      <button type="button" class="btn" data-report-cancel>Cancel</button>
      <button class="btn btn-gold" value="make">Make my report</button>
    </div>
  </form>
</dialog>

<dialog class="confirm pseudo-dialog" data-pseudo aria-labelledby="pseudo-title">
  <form method="dialog">
    <h2 id="pseudo-title">Pseudocode ↔ JavaScript</h2>
    <p>OCR exam pseudocode on the left, the JavaScript you write on the right.</p>
    <PseudocodePanel />
    <div class="row"><button class="btn btn-gold" value="close" autofocus>Close</button></div>
  </form>
</dialog>

<style is:global>
  body.sixth {
    font-size: 16px;
  }
  .wb {
    height: 100%;
    display: grid;
    grid-template-columns: 320px minmax(0, 1fr) minmax(0, 1fr);
    gap: 14px;
    padding: 14px;
  }
  .wb .panel {
    background: #fff;
    border: 3px solid var(--navy);
    border-radius: 6px;
    min-width: 0;
  }
  /* Students must see >= and != exactly as typed. */
  .wb code,
  .wb pre,
  .pseudo-dialog pre,
  .pseudo-dialog code {
    font-variant-ligatures: none;
  }
  /* The exam boss is all questions: give them more room. */
  .wb.boss {
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr) minmax(0, 1fr);
  }
  .wb-goals {
    padding: 14px 16px;
    overflow: auto;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .wb-goals .head {
    display: flex;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
  }
  .wb .level-tag {
    font-size: 10px;
    color: var(--gold-text);
    margin: 0;
  }
  .wb .level-title {
    font-size: 22px;
    color: var(--navy);
  }
  .wb .intro {
    color: #3a4654;
    margin: 0;
  }
  .wb .sub {
    font-size: 16px;
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 6px;
    flex-wrap: wrap;
  }
  .sub-note {
    font-size: 14px;
    font-weight: 400;
    color: var(--muted);
    margin: 0;
  }
  .pill {
    font: 600 11px var(--body);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 2px 8px;
    border-radius: 999px;
    border: 1.5px solid;
  }
  .pill.build { color: var(--blue-dark); border-color: var(--blue-dark); }
  .pill.fix { color: var(--red); border-color: var(--red); }
  .pill.trace { color: var(--green-dark); border-color: var(--green-dark); }
  .pill.exam { color: var(--gold-text); border-color: var(--gold-dark); }

  .wb .goals {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .wb .goal {
    display: grid;
    grid-template-columns: 24px 1fr;
    gap: 10px;
  }
  .wb .tick {
    width: 24px;
    height: 24px;
    border: 3px solid var(--navy);
    border-radius: 3px;
    margin-top: 2px;
    display: grid;
    place-items: center;
    font-weight: 700;
    font-size: 14px;
  }
  .wb .goal[data-state='pass'] .tick {
    background: var(--green);
    border-color: var(--green-dark);
    color: #fff;
  }
  .wb .goal[data-state='pass'] .tick::before { content: '✓'; }
  .wb .goal[data-state='pending'] .tick { border-style: dashed; }
  .wb .goal.stretch .goal-text::before {
    content: 'Stretch';
    font: 600 11px var(--body);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--gold-text);
    margin-right: 6px;
  }
  .wb .goal-row {
    display: flex;
    gap: 8px;
    align-items: flex-start;
    justify-content: space-between;
  }
  .wb .goal-text { margin: 0; font-size: 15px; }
  .wb .goal-text code, .wb .hints code, .wb .goal-msg code, .challenge code { font: 13.5px var(--mono); background: #eef3f9; padding: 0 4px; border-radius: 3px; }
  .wb .goal[data-state='pass'] .goal-text { color: var(--muted); }
  .wb .hint-btn {
    font-size: 13px;
    padding: 2px 8px;
    min-height: 32px;
    flex: none;
  }
  .wb .spec {
    margin: 2px 0 0;
    font: 12px var(--mono);
    color: var(--muted);
  }
  .wb .goal-msg {
    margin: 6px 0 0;
    font-size: 14px;
    color: #7a1c15;
    background: var(--red-soft);
    border-radius: 6px;
    padding: 6px 10px;
  }
  .wb .hints {
    margin: 6px 0 0;
    padding: 6px 10px 6px 28px;
    background: var(--cream);
    border-left: 3px solid var(--gold);
    font-size: 14px;
  }

  /* Challenges */
  .challenges { display: flex; flex-direction: column; gap: 10px; border-top: 2px dashed var(--line); padding-top: 10px; }
  [data-challenges] { display: flex; flex-direction: column; gap: 10px; }
  .challenge {
    border: 2px solid var(--line);
    border-radius: 6px;
    padding: 10px 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 15px;
  }
  .challenge[data-done='true'] { border-color: #a9dcbc; background: #f3fbf6; }
  .challenge h3 { font-size: 15px; display: flex; gap: 8px; align-items: center; flex-wrap: wrap; margin: 0; }
  .challenge h3 .state { margin-left: auto; font: 600 12px var(--body); color: var(--green-dark); }
  .challenge p { margin: 0; }
  .challenge .file-name { font: 12px var(--mono); color: var(--muted); margin-bottom: -4px; }
  .challenge pre.code {
    margin: 0;
    background: #0d2136;
    color: #dce6f2;
    font: 13px/1.55 var(--mono);
    padding: 8px 10px;
    border-radius: 4px;
    overflow-x: auto;
    counter-reset: ln;
  }
  .challenge pre.code span { display: block; white-space: pre; }
  .challenge pre.code span::before {
    counter-increment: ln;
    content: counter(ln);
    display: inline-block;
    width: 2ch;
    margin-right: 10px;
    text-align: right;
    color: #6f86a1;
  }
  .challenge .mini-editor { height: 170px; border-radius: 4px; overflow: hidden; border: 1px solid #1e3a5a; }
  .challenge .mini-editor .cm-editor { height: 100%; }
  .challenge .row { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
  .challenge label { font-weight: 600; font-size: 14px; }
  .challenge input[type='text'] {
    font: 15px var(--mono);
    width: 10em;
    padding: 6px 8px;
    min-height: 40px;
    border: 2px solid var(--navy);
    border-radius: 3px;
  }
  .challenge textarea {
    font: 15px var(--body);
    width: 100%;
    min-height: 80px;
    padding: 8px 10px;
    border: 2px solid var(--navy);
    border-radius: 4px;
    resize: vertical;
  }
  .challenge .btn { min-height: 40px; padding: 4px 12px; font-size: 14px; }
  .challenge .result { font-size: 14px; font-weight: 500; margin: 0; }
  .challenge .result.good { color: var(--green-dark); }
  .challenge .result.bad { color: var(--red); }
  .challenge .marks { font: 700 14px var(--mono); margin-left: auto; }
  .challenge .scheme { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 6px; font-size: 14px; }
  .challenge .scheme li { display: grid; grid-template-columns: 22px 1fr; gap: 6px; }
  .challenge .scheme input { width: 18px; height: 18px; margin-top: 2px; accent-color: var(--green); }
  .challenge .console-out {
    margin: 0;
    font: 13px var(--mono);
    background: #f3f6fa;
    border-radius: 4px;
    padding: 6px 10px;
    white-space: pre-wrap;
  }

  /* Editor */
  .wb-editor {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: #0d2136 !important;
  }
  .tabbar {
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    background: #0a1b2e;
    border-bottom: 1px solid #1e3a5a;
    flex-wrap: wrap;
  }
  .tabs { display: flex; overflow-x: auto; }
  .tabs [role='tab'] {
    font: 500 14px var(--mono);
    color: #8fa6c0;
    background: none;
    border: 0;
    border-right: 1px solid #1e3a5a;
    padding: 0 16px;
    min-height: 44px;
    cursor: pointer;
    display: flex;
    gap: 8px;
    align-items: center;
    white-space: nowrap;
  }
  .tabs [role='tab'][aria-selected='true'] { color: #fff; background: #0d2136; box-shadow: inset 0 3px 0 var(--gold); }
  .tabs [role='tab']:focus-visible { outline: 3px solid var(--gold); outline-offset: -3px; }
  .tabs .dot { width: 8px; height: 8px; border-radius: 50%; }
  .tabs [role='tab'].new::after { content: 'NEW'; font: 600 10px var(--body); color: var(--navy); background: var(--gold); border-radius: 3px; padding: 0 4px; }
  .tools { display: flex; flex-wrap: wrap; }
  .tool {
    font: 500 13px var(--body);
    color: #c5d3e3;
    background: none;
    border: 0;
    padding: 0 10px;
    min-height: 44px;
    cursor: pointer;
  }
  .tool:hover { color: #fff; text-decoration: underline; }
  .tool:focus-visible { outline: 3px solid var(--gold); outline-offset: -3px; }
  .editors { flex: 1; min-height: 0; position: relative; }
  .editors > div { position: absolute; inset: 0; }
  .editors .cm-editor { height: 100%; }
  .editors > div:focus-within { box-shadow: inset 0 0 0 2px var(--gold); }
  .ed-foot {
    margin: 0;
    display: flex;
    justify-content: space-between;
    gap: 10px;
    padding: 6px 12px;
    border-top: 1px solid #1e3a5a;
    font: 12px var(--mono);
    color: #8fa6c0;
    flex-wrap: wrap;
  }

  /* Right column */
  .wb-right { display: flex; flex-direction: column; gap: 14px; min-height: 0; min-width: 0; }
  .wb .preview { display: flex; flex-direction: column; flex: 1 1 0; min-height: 0; overflow: hidden; }
  .wb .chrome { display: flex; align-items: flex-end; gap: 12px; background: var(--navy); padding: 8px 10px 0; }
  .wb .dots { display: flex; gap: 6px; padding-bottom: 12px; }
  .wb .dots i { width: 10px; height: 10px; background: #5b6b7d; }
  .wb .dots i:first-child { background: #d9455f; }
  .wb .dots i:nth-child(2) { background: var(--gold); }
  .wb .tab { display: flex; align-items: center; gap: 8px; max-width: 60%; background: #f3f6fa; color: var(--navy); padding: 7px 14px; border-radius: 8px 8px 0 0; font-size: 14px; font-weight: 500; }
  .wb .tab-icon { width: 12px; height: 12px; flex: none; background: var(--gold); border: 2px solid var(--navy); }
  .wb .tab-title { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .wb .tab-title.empty { font-style: italic; color: #5b6573; }
  .wb .why { font: 11px var(--mono); color: #5b6573; border-left: 1px solid var(--line); padding-left: 8px; }
  .rerun { margin-left: auto; margin-bottom: 6px; background: none; border: 1px solid #5b6b7d; color: #dce6f2; font: 500 12px var(--body); border-radius: 4px; padding: 4px 8px; cursor: pointer; }
  .rerun:hover { border-color: var(--gold); color: #fff; }
  .wb .address { display: flex; align-items: center; gap: 8px; background: #f3f6fa; border-bottom: 1px solid var(--line); padding: 5px 12px 6px; font: 13px var(--mono); color: #3a4654; }
  .wb .lock { width: 10px; height: 10px; border: 2px solid #5b6573; border-radius: 2px; }
  .wb .frame-wrap { position: relative; flex: 1; min-height: 200px; background: #fff; }
  .wb .frame-wrap iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; background: #fff; }
  .alert-box {
    position: absolute;
    z-index: 2;
    top: 16px;
    left: 50%;
    transform: translateX(-50%);
    width: min(360px, calc(100% - 32px));
    background: #fff;
    border: 3px solid var(--navy);
    border-radius: 8px;
    box-shadow: 0 10px 30px rgba(10, 27, 46, 0.35);
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .alert-head { margin: 0; font: 600 12px var(--body); letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
  .alert-text { margin: 0; white-space: pre-wrap; word-break: break-word; }
  .alert-box .btn { align-self: flex-end; min-height: 40px; }
  .wb .link-note { margin: 0; padding: 6px 12px; background: var(--cream); border-top: 1px solid var(--cream-line); font-size: 14px; color: #4a3300; }

  .console { flex: none; padding: 0; max-height: 150px; display: flex; flex-direction: column; overflow: hidden; }
  .console summary { display: flex; align-items: center; gap: 8px; padding: 6px 12px; font-weight: 600; font-size: 14px; cursor: pointer; min-height: 36px; }
  .console .count { font-weight: 400; color: var(--muted); font-size: 13px; }
  .console .clear { margin-left: auto; font: 500 12px var(--body); background: none; border: 1px solid var(--line); border-radius: 4px; padding: 2px 8px; cursor: pointer; }
  .console .lines { list-style: none; margin: 0; padding: 0 0 4px; overflow: auto; font: 13px/1.5 var(--mono); border-top: 1px solid var(--line); }
  .console .lines li { padding: 3px 12px; border-bottom: 1px solid #eef2f7; display: flex; gap: 10px; align-items: baseline; }
  .console .lines li .k { font: 600 10px var(--body); letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); flex: none; width: 5.5em; }
  .console .lines li.error { background: var(--red-soft); color: #7a1c15; }
  .console .lines li.alert .k { color: var(--gold-text); }
  .console .lines li .msg { flex: 1; white-space: pre-wrap; word-break: break-word; }
  .console .lines li button { font: 12px var(--mono); background: none; border: 0; color: var(--blue-dark); text-decoration: underline; cursor: pointer; padding: 0; }
  .console .lines .empty { color: var(--muted); font-family: var(--body); }

  .wb .feedback { flex: none; padding: 10px 14px; display: flex; flex-direction: column; gap: 10px; }
  .wb .say { display: flex; gap: 12px; align-items: flex-start; }
  .wb .bubble { flex: 1; min-width: 0; background: var(--cream); border: 2px solid var(--cream-line); border-radius: 12px; padding: 8px 12px; display: flex; flex-direction: column; align-items: flex-start; gap: 4px; max-height: 120px; overflow: auto; }
  .wb .bubble.good { background: #e7f5ec; border-color: #a9dcbc; }
  .wb .message { color: #33260a; font-weight: 500; margin: 0; font-size: 15px; }
  .wb .bubble.good .message { color: #0f4d2c; }
  .wb .goto { min-height: 32px !important; padding: 2px 8px !important; font-size: 14px !important; margin-left: -8px; }
  .wb .mistakes { margin: 2px 0 0; padding-left: 18px; font-size: 14px; color: #4a3300; }
  .wb .actions { display: flex; gap: 10px; justify-content: flex-end; flex-wrap: wrap; }
  .wb .actions .btn-big { min-height: 48px; padding: 8px 20px; font-size: 16px; }
  .wb .report-btn { margin-right: auto; min-height: 48px; padding: 4px 8px; font-size: 14px; }

  .check-frames { position: absolute; left: -10000px; top: 0; width: 800px; height: 600px; visibility: hidden; }
  .check-frames iframe { width: 100%; height: 400px; border: 0; }

  .confirm { border: 4px solid var(--navy); border-radius: 8px; padding: 22px 26px; max-width: 460px; font-family: var(--body); }
  .confirm::backdrop { background: rgba(10, 27, 46, 0.6); }
  .confirm h2 { font-size: 22px; margin-bottom: 8px; }
  .confirm .row { display: flex; gap: 12px; justify-content: flex-end; margin-top: 18px; flex-wrap: wrap; }
  .report form { display: flex; flex-direction: column; gap: 6px; }
  .report label { font-weight: 600; margin-top: 10px; }
  .report input { font: 18px var(--body); padding: 10px 14px; min-height: 48px; border: 3px solid var(--navy); border-radius: 4px; }
  .report .note { font-size: 15px; color: var(--muted); }
  .celebrate { position: fixed; z-index: 50; pointer-events: none; }
