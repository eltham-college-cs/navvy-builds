---
import Base from '../layouts/Base.astro';
import LogoScene from '../components/LogoScene.astro';
import { allLessons } from '../lib/lessons';
import { url } from '../lib/url';

const lessons = await allLessons();
const first = lessons[0];
---
<Base title="Na<>y Builds" current="home" description="Build your own web page with HTML and CSS, level by level.">
  <div class="wrap home">
    <LogoScene />

    <section class="intro">
      <div>
        <h1>Build a real web page, one level at a time</h1>
        <p>Write HTML and CSS on the left. See your page appear on the right. Every goal ticks as you get it right, and hints are there if you get stuck.</p>
      </div>
      <a class="btn btn-gold btn-big" href={url(`lessons/${first.id}/`)}>Start building</a>
    </section>

    <section aria-labelledby="lessons-heading" id="lessons">
      <h2 id="lessons-heading">Lessons</h2>
      <ul class="lessons">
        {
          lessons.map((lesson, i) => (
            <li class="card lesson">
              <span class="code-block num">{String(i + 1).padStart(2, '0')}</span>
              <div class="info">
                <p class="eyebrow">Year {lesson.year} · about {lesson.minutes} minutes · {lesson.levels.length} levels</p>
                <h3>
                  <a href={url(`lessons/${lesson.id}/`)}>{lesson.title}</a>
                </h3>
                <p>{lesson.summary}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="how" aria-labelledby="how-heading">
      <h2 id="how-heading">How it works</h2>
      <ol>
        <li><strong>Pick your hobby.</strong> Your page is about something you love.</li>
        <li><strong>Clear each level.</strong> Type the code yourself and press <em>Check my page</em>.</li>
        <li><strong>Keep your page.</strong> Your work saves in this browser. Download it when you finish.</li>
      </ol>
      <p class="privacy">Nothing you type leaves your computer. No accounts, no tracking.</p>
    </section>
  </div>
</Base>

<style>
  .home {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .intro {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    flex-wrap: wrap;
  }
  .intro > div {
    max-width: 720px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .intro h1 {
    font-size: 36px;
  }
  .intro p {
    font-size: 20px;
    color: #3a4654;
  }
  h2 {
    font-size: 28px;
    margin-bottom: 16px;
  }
  .lessons {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 16px;
  }
  .lesson {
    display: flex;
    gap: 24px;
    align-items: center;
  }
  .num {
    width: 72px;
    height: 72px;
    font-size: 16px;
  }
  .info {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .info h3 {
    font-size: 26px;
  }
  .info h3 a {
    color: var(--navy);
  }
  .how ol {
    margin: 0;
    padding-left: 1.4em;
    display: grid;
    gap: 8px;
  }
  .privacy {
    margin-top: 16px;
    color: var(--muted);
    font-size: 16px;
  }
  @media (max-width: 640px) {
    .intro h1 {
      font-size: 28px;
    }
    .lesson {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
