---
import '@fontsource/lexend/400.css';
import '@fontsource/lexend/500.css';
import '@fontsource/lexend/600.css';
import '@fontsource/press-start-2p/400.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/theme.css';
import SiteHeader from '../components/SiteHeader.astro';
import { url } from '../lib/url';

interface Props {
  title: string;
  description?: string;
  current?: 'home' | 'help' | 'lesson';
  /** Full-height app layout (the builder), with no page scroll on a laptop. */
  app?: boolean;
}
const { title, description = 'Practise HTML and CSS, level by level.', current, app = false } = Astro.props;
const fullTitle = title === 'Na<>y Builds' ? title : `${title} · Na<>y Builds`;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="referrer" content="no-referrer" />
    <title>{fullTitle}</title>
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
  </head>
  <body class:list={{ app }}>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader current={current}><slot name="header" /></SiteHeader>
    <main id="main" tabindex="-1">
      <slot />
    </main>
  </body>
</html>

<style is:global>
  body.app {
    height: 100vh;
    height: 100dvh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  body.app > main {
    flex: 1;
    min-height: 0;
  }
  main:focus {
    outline: none;
  }
  @media (max-width: 1000px), (max-height: 600px) {
    body.app {
      height: auto;
      overflow: visible;
    }
  }
</style>
